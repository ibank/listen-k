<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron runtime defaults (needed for V8 JIT and dynamic dylib loading) -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>

  <!-- Required for transcribe-helper (AVAudioEngine) and
       apple-speech-helper (SFSpeechRecognizer) to capture microphone input.
       Without this, TCC silently denies the request under hardened runtime
       and never shows a permission prompt. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- Required for paste-helper / focus-helper when sending Apple events
       to other apps (System Events, frontmost app activation). CGEventPost
       itself relies on Accessibility TCC, but this entitlement keeps the
       event path open for any AppleScript-style fallback. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
