{
  "name": "listen-k",
  "version": "0.8.1",
  "description": "Listen K — AI voice dictation for macOS. Local WhisperKit / Apple Speech / whisper.cpp engines with optional OpenAI (BYOK) and Ollama post-processing. First-class Korean, Japanese, and Chinese.",
  "author": "ibank <hello@listenk.com>",
  "license": "MIT",
  "homepage": "https://listenk.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ibank/listen-k.git"
  },
  "bugs": {
    "url": "https://github.com/ibank/listen-k/issues",
    "email": "hello@listenk.com"
  },
  "keywords": [
    "whisper",
    "dictation",
    "macos",
    "korean",
    "japanese",
    "chinese",
    "whisperkit",
    "electron",
    "ollama",
    "speech-to-text",
    "local-first",
    "privacy",
    "accessibility"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "main": "main.js",
  "scripts": {
    "prestart": "bash scripts/patch-dev-electron-plist.sh",
    "start": "electron .",
    "icon": "node scripts/generate-icon.js",
    "icon:dmg": "bash scripts/build-dmg-icon.sh",
    "icon:tray": "node scripts/generate-tray-icon.js",
    "build:helper": "bash scripts/build-helper.sh",
    "build:transcribe": "bash scripts/build-transcribe-helper.sh",
    "build:whisper": "bash scripts/build-whisper.sh",
    "model:whisperkit": "bash scripts/download-whisperkit-model.sh",
    "model:whisperkit:base": "bash scripts/download-whisperkit-model.sh openai_whisper-base",
    "model:whisperkit:small": "bash scripts/download-whisperkit-model.sh openai_whisper-small",
    "model:whisperkit:turbo": "bash scripts/download-whisperkit-model.sh openai_whisper-large-v3-v20240930_turbo_632MB",
    "model:whisperkit:accurate": "bash scripts/download-whisperkit-model.sh openai_whisper-large-v3-v20240930_626MB",
    "model:ggml:tiny": "bash scripts/download-model.sh tiny",
    "model:ggml:base": "bash scripts/download-model.sh base",
    "model:ggml:small": "bash scripts/download-model.sh small",
    "smoke": "bash scripts/smoke.sh",
    "predist": "npm run build:helper && npm run build:transcribe && npm run model:whisperkit:base",
    "dist": "electron-builder --mac dmg zip",
    "dist:dir": "electron-builder --mac --dir"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.eazler.listenk",
    "productName": "Listen K",
    "artifactName": "ListenK-${version}-${arch}.${ext}",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "ibank",
        "repo": "listen-k",
        "releaseType": "draft"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "scripts/after-pack.js",
    "files": [
      "main.js",
      "preload.js",
      "preload-hud.js",
      "preload-tray.js",
      "index.html",
      "hud.html",
      "tray.html",
      "styles.css",
      "hud.css",
      "tray.css",
      "renderer.js",
      "hud.js",
      "tray.js",
      "i18n.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*",
          "!translate-helper"
        ]
      },
      {
        "from": "build/trayIconTemplate.png",
        "to": "icons/trayIconTemplate.png"
      },
      {
        "from": "build/trayIconTemplate@2x.png",
        "to": "icons/trayIconTemplate@2x.png"
      },
      {
        "from": "models/whisperkit",
        "to": "models/whisperkit",
        "filter": [
          "openai_whisper-base/**"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Listen K uses the microphone to transcribe your voice into text.",
        "NSSpeechRecognitionUsageDescription": "Listen K uses macOS Speech Recognition when the Apple Speech engine is selected. Choose on-device mode in System Settings to keep audio on this Mac.",
        "NSAppleEventsUsageDescription": "Listen K sends Apple events to the focused app to paste the transcribed text into its input field.",
        "LSUIElement": true,
        "LSMinimumSystemVersion": "14.0"
      },
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Listen K ${version}",
      "icon": "build/dmg-icon.icns",
      "iconSize": 110,
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
